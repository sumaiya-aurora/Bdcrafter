# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Email (SMTP) — use Mailtrap/Ethereal for testing, real SMTP for production
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_smtp_username
EMAIL_HOST_PASSWORD=your_smtp_password

# Store configuration
ADMIN_EMAIL=admin@bdcrafter.com
FROM_EMAIL=support@bdcrafter.com
STORE_NAME=Bdcrafter.com
STORE_PHONE=+880 1234 567890
STORE_ADDRESS=Dhaka, Bangladesh
